<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable e ImplicitUsings vienen de Directory.Build.props -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Solo para "dotnet ef migrations": se usa al desarrollar y no se publica (PrivateAssets). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Proveedor de EF Core para SQL Server LocalDB (trae EF Core como dependencia). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biblioteca.Contracts\Biblioteca.Contracts.csproj" />
  </ItemGroup>

</Project>
