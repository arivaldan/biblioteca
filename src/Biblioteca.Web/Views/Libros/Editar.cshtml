@using Biblioteca.Contracts.Libros
@model ActualizarLibroDto
@{
    ViewData["Title"] = "Editar libro";
    // El id no está en ActualizarLibroDto: viene en la ruta (/Libros/Editar/5), igual que en la Api.
    object? idLibro = ViewContext.RouteData.Values["id"];
}

<h1 class="mb-3">Editar libro</h1>

@* Mismos campos que Crear.cshtml (ver el comentario de esa vista). *@
<form asp-action="Editar" asp-route-id="@idLibro" method="post" class="card card-body formulario">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" maxlength="200" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Autor" class="form-label">Autor</label>
        <input asp-for="Autor" class="form-control" maxlength="150" />
        <div class="form-text">Si son varios, sepáralos con coma.</div>
        <span asp-validation-for="Autor" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Isbn" class="form-label">ISBN</label>
        <input asp-for="Isbn" class="form-control" />
        <div class="form-text">ISBN-10 o ISBN-13. Se pueden escribir guiones y espacios.</div>
        <span asp-validation-for="Isbn" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="AnioPublicacion" class="form-label">Año de publicación (opcional)</label>
            <input asp-for="AnioPublicacion" class="form-control" />
            <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="CantidadEjemplares" class="form-label">Ejemplares</label>
            <input asp-for="CantidadEjemplares" class="form-control" />
            <span asp-validation-for="CantidadEjemplares" class="text-danger"></span>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Guardar cambios
        </button>
        <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@idLibro">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
