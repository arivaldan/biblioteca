@using Biblioteca.Contracts.Libros
@model List<LibroDto>
@{
    ViewData["Title"] = "Libros";
    bool apiNoDisponible = ViewData["ApiNoDisponible"] is true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Libros</h1>
    @* Los botones con data-url-formulario abren el modal con ese formulario (ver site.js). *@
    <button type="button" id="boton-nuevo-libro" class="btn btn-success" data-url-formulario="@Url.Action("Crear")">
        <i class="bi bi-plus-lg"></i> Nuevo libro
    </button>
</div>

@if (apiNoDisponible)
{
    <partial name="_AlertaApiNoDisponible" />
}
else if (Model.Count == 0)
{
    <div class="alert alert-info">No hay libros registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>ISBN</th>
                    <th class="text-end">Año</th>
                    <th class="text-end">Ejemplares</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (LibroDto libro in Model)
                {
                    <tr>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.Isbn</td>
                        <td class="text-end">@(libro.AnioPublicacion?.ToString() ?? "—")</td>
                        <td class="text-end">@libro.CantidadEjemplares</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@libro.Id" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Editar"
                                    data-url-formulario="@Url.Action("Editar", new { id = libro.Id })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @* site.js intercepta este formulario para pedir confirmación (RW-07). *@
                            <form asp-action="Eliminar" asp-route-id="@libro.Id" method="post"
                                  class="form-eliminar d-inline" data-titulo="@libro.Titulo">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_ModalFormulario" />

@section Scripts {
    @* Validación en el navegador del formulario del modal (decisión 4 de la spec). *@
    <partial name="_ValidationScriptsPartial" />
}
