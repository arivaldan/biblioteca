@{
    // Controller de la página actual, para marcar en el menú la opción activa.
    string? controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <nav id="menu-lateral" class="menu-lateral bg-dark" aria-label="Menú principal">
            <a class="menu-lateral-marca" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half"></i> Biblioteca
            </a>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(controllerActual == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(controllerActual == "Libros" ? "active" : "")"
                       asp-controller="Libros" asp-action="Index">
                        <i class="bi bi-journal-bookmark"></i> Libros
                    </a>
                </li>
                @* Socios y Préstamos todavía no existen: se muestran deshabilitados. *@
                <li class="nav-item">
                    <span class="nav-link disabled" aria-disabled="true">
                        <i class="bi bi-people"></i> Socios
                        <span class="badge text-bg-secondary">Próximamente</span>
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link disabled" aria-disabled="true">
                        <i class="bi bi-arrow-left-right"></i> Préstamos
                        <span class="badge text-bg-secondary">Próximamente</span>
                    </span>
                </li>
            </ul>
        </nav>

        <div class="flex-grow-1">
            <header class="barra-superior border-bottom">
                <button id="boton-menu" class="btn btn-outline-secondary" type="button"
                        aria-controls="menu-lateral" aria-expanded="true" aria-label="Mostrar u ocultar el menú">
                    <i class="bi bi-list"></i>
                </button>
            </header>
            <main role="main" class="container-fluid py-3">
                @RenderBody()
            </main>

            @*
                Mensajes que deja un controller en TempData antes de redirigir (RW-08).
                Van en atributos data- (Razor los codifica) y site.js los muestra con SweetAlert2.
            *@
            <div id="mensajes" hidden
                 data-exito="@TempData["MensajeExito"]"
                 data-error="@TempData["MensajeError"]"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
